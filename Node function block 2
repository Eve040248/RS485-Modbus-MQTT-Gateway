let data = msg.payload;

if (typeof data === 'string') {
    try { data = JSON.parse(data); } catch(e) { data = {}; }
}

let alertText = "⚠️ **[แจ้งเตือนระบบไฟฟ้า PZEM]**\n" +
                "----------------------------------\n" +
                "📍 **มิเตอร์ ID:** " + (data.meter_id || "1") + "\n" +
                "⚡ **แรงดัน:** " + (data.voltage || "0") + " V\n" +
                "🔌 **กระแส:** " + (data.current || "0") + " A\n" +
                "🚨 **สถานะ:** " + (data.status || "UNKNOWN") + "\n" +
                "⏰ **เวลา:** " + new Date().toLocaleString("th-TH");

msg.headers = {
    "Content-Type": "application/json"
};

// Discord ต้องการโครงสร้างที่มี "content"
msg.payload = {
    "content": alertText
};

return msg;
